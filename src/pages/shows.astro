---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.tsx';
import ShowList from '../components/ShowList.tsx';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Shows — Band Name" description="Upcoming shows and tickets.">
  <Nav client:load />
  <main class="flex-1 overflow-y-auto pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1
        class="text-4xl md:text-5xl font-black text-white text-center mt-4 mb-8"
      >
        Shows
      </h1>

      <ShowList client:load />
    </div>
  </main>
  <Footer />
</Layout>
