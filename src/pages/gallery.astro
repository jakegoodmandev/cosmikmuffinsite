---
import Footer from '../components/Footer.astro';
import GalleryGrid from '../components/GalleryGrid.tsx';
import Nav from '../components/Nav.tsx';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Gallery — Band Name" description="Photos from live shows.">
  <Nav client:load />
  <main class="flex-1 overflow-y-auto pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-black text-white mt-4 mb-8">
        Gallery
      </h1>
      <p class="text-white/60 mb-12">
        Photos from recent shows. Click any image to view it larger.
      </p>

      <GalleryGrid client:load />
    </div>
  </main>
  <Footer />
</Layout>
