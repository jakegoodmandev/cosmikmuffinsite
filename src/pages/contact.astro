---
import ContactForm from '../components/ContactForm.tsx';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.tsx';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Contact — Band Name" description="Get in touch with the band.">
  <Nav client:load />
  <main class="flex-1 overflow-hidden pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1
        class="text-4xl md:text-5xl font-black text-white text-center mt-4 mb-4"
      >
        Contact
      </h1>
      <p class="text-white/60 mb-8 text-center max-w-2xl mx-auto">
        Booking, press, or just saying hello — drop us a message and we’ll get
        back to you.
      </p>

      <ContactForm client:load />

      <div class="mt-8 text-center">
        <p class="text-sm text-white/40">
          Management:
          <a
            href="mailto:info@example.com"
            class="text-white/70 hover:text-band-accent"
            >info@example.com</a
          >
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
