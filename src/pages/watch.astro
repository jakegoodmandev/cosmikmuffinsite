---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.tsx';
import YouTubeEmbed from '../components/YouTubeEmbed.tsx';
import videos from '../data/videos.json';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="Watch — Cosmik Muffin Experience"
  description="Watch official music videos and live sessions."
>
  <Nav client:load />
  <main class="flex-1 overflow-y-auto pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1
        class="text-4xl md:text-5xl font-black text-white text-center mt-4 mb-8"
      >
        Watch
      </h1>

      <div class="grid grid-cols-1 gap-8">
        {videos.map((video) => (
          <div class="space-y-3">
            <YouTubeEmbed youtubeId={video.youtubeId} title={video.title} />
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
