---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.tsx';
import Footer from '../components/Footer.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.tsx';
import videos from '../data/videos.json';
import '../styles/global.css';
---

<Layout title="Watch — Band Name" description="Watch official music videos and live sessions.">
  <Nav client:load />
  <main class="flex-1 py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-black text-white mb-4">Watch</h1>
      <p class="text-white/60 mb-12 max-w-2xl">
        Official videos, live sessions, and behind-the-scenes footage.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {videos.map((video) => (
          <div class="space-y-3">
            <YouTubeEmbed youtubeId={video.youtubeId} title={video.title} />
            <div>
              <h2 class="text-xl font-bold text-white">{video.title}</h2>
              <p class="text-sm text-white/60">{video.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
