---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.tsx';
import Footer from '../components/Footer.astro';
import TourList from '../components/TourList.tsx';
import '../styles/global.css';
---

<Layout title="Tour — Band Name" description="Upcoming tour dates and tickets.">
  <Nav client:load />
  <main class="flex-1 py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-black text-white mb-4">Tour Dates</h1>
      <p class="text-white/60 mb-12">
        Catch us live in a city near you. Tickets available through the venue links.
      </p>

      <TourList client:load />
    </div>
  </main>
  <Footer />
</Layout>
