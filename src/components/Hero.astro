---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title = 'Best Toronto Zappa Tribute', subtitle = '' } = Astro.props;
---

<section
  class="relative flex min-h-full w-full items-center bg-[#18130d] px-6 pb-24 pt-24 sm:px-10"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(225,179,91,0.14),_transparent_65%)]"
  />

  <div
    class="relative mx-auto grid w-full max-w-6xl items-center gap-8 md:grid-cols-2 md:gap-12"
  >
    <div class="text-center md:text-left">
      <p class="mb-4 text-sm uppercase tracking-widest text-[#e5c381]">
        Live at Bovine · December 4
      </p>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white"
      >
        {title}
      </h1>
      {subtitle && <p class="mt-4 text-lg text-white/80">{subtitle}</p>}
      <p class="mt-5 text-base leading-relaxed text-white/70">
        Three tributes. One night.<br />
        KISS, Frank Zappa &amp; Black Sabbath.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          href="https://tixert.com/events/live-tributes-to-black-sabbath-frank-zappa-kiss"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-band-accent px-7 py-3 text-sm font-bold text-white hover:bg-fuchsia-500"
        >
          Get Tickets
        </a>
        <a
          href="/shows"
          class="rounded-full border border-white/30 px-7 py-3 text-sm font-bold text-white hover:bg-white/10"
        >
          See Shows
        </a>
        <a
          href="/watch"
          class="rounded-full border border-white/30 px-7 py-3 text-sm font-bold text-white hover:bg-white/10"
        >
          Watch Videos
        </a>
      </div>
    </div>
    <a
      href="/shows"
      aria-label="December 4 at Bovine Sex Club — show details"
      class="mx-auto block w-full max-w-sm md:max-w-md"
    >
      <img
        src="/images/bovine-dec-4-2026-poster.jpg"
        alt="December 4 Bovine Sex Club poster featuring Hotter Than Heck, Cosmik Muffin Experience and Dad Sabbath"
        width="2579"
        height="3296"
        fetchpriority="high"
        class="h-auto w-full rounded-sm shadow-2xl md:max-h-[calc(100dvh-12rem)] md:object-contain"
      >
    </a>
  </div>
</section>
