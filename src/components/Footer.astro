---
import { Icon } from 'astro-icon/components';

const socialLinks = [
  { label: 'Instagram', href: 'https://instagram.com', icon: 'simple-icons:instagram' },
  { label: 'YouTube', href: 'https://youtube.com', icon: 'simple-icons:youtube' },
];
---

<footer class="fixed bottom-0 left-0 right-0 z-40 border-t border-white/10 bg-black/40 h-16 flex items-center">
  <div
    class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4"
  >
    <p class="text-xs md:text-sm text-white/50">
      © {new Date().getFullYear()} The Cosmik Muffin Experience. All rights
      reserved.
    </p>

    <div class="flex items-center gap-6 flex-shrink-0">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          class="text-white/70 hover:text-band-accent transition-colors"
        >
          <Icon name={link.icon} class="w-6 h-6" />
        </a>
      ))}
    </div>
  </div>
</footer>
