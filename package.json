{
  "name": "cosmikmuffinsite",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.4-canary.1",
  "scripts": {
    "dev": "bun --bun astro dev",
    "start": "bun run dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint:fix": "bun lint --fix",
    "check": "bun lint && bun fmt --check",
    "check:ci": "bun run check",
    "test:e2e": "bun --bun playwright test",
    "test:e2e:ui": "bun --bun playwright test --ui",
    "test:e2e:install": "bun --bun playwright install chromium"
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "@astrojs/tailwind": "^5.0.0",
    "@astrojs/ts-plugin": "^1.10.0",
    "@astrojs/vercel": "^8.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^5.0.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.93",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "astro-icon": "^1.1.5",
    "typescript": "^5.6.0"
  }
}
